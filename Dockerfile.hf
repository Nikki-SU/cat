FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# Copy backend code
COPY backend/ .

# Copy frontend build
COPY backend/static ./static

# Create persistent data directory (HF Spaces uses /data for persistence)
RUN mkdir -p /data/attachments /data/structured

# Environment variables for data paths
ENV CAT_DATA_DIR=/data
ENV DATABASE_URL=sqlite:////data/cat.db
ENV ATTACHMENTS_DIR=/data/attachments
ENV STRUCTURED_DIR=/data/structured
ENV CAT_NO_BROWSER=1

# HF Spaces uses port 7860
EXPOSE 7860

# Run
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
